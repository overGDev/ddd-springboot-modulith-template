# Copy this file to .env and fill in your own local values.
# .env is gitignored - never commit real credentials.
# VS Code's Run/Debug config (.vscode/launch.json) loads this file
# automatically via its 'envFile' setting, so `mvn spring-boot:run` and
# the IDE launcher both pick up the same variables.


# Which Spring profile to activate on startup (see application.properties
# / application-<profile>.properties for profile-specific overrides).
SPRING_PROFILES_ACTIVE='dev'


# --- Migration datasource (used only at startup, by Flyway) ---
# Connects as ddd_migrator: owns the schema and holds DDL privileges.
# Spring Boot wires this up as a separate datasource from spring.datasource
# whenever spring.flyway.url/user/password are set.
# See scripts/db/setup-roles.sql for how both roles/database are created.
FLYWAY_URL='jdbc:postgresql://localhost:5432/ddd_template'
FLYWAY_USERNAME='ddd_migrator'
FLYWAY_PASSWORD='changeme_migrator'


# --- Runtime datasource (used by Hikari/JPA while the app is running) ---
# Connects as ddd_app: a role with DML privileges only (SELECT/INSERT/
# UPDATE/DELETE). It cannot create, alter, or drop tables. This limits the
# blast radius of a leaked credential or an injection bug to data tampering,
# not schema destruction.
#
# This URL assumes a single app instance talking directly to Postgres
# (the default - see docs/scaling.md) so server-side prepared statements
# stay enabled. Only add prepareThreshold=0 and point at PgBouncer's port
# once you're running multiple instances - see docs/scaling.md for why.
DB_URL='jdbc:postgresql://localhost:5432/ddd_template?sslmode=disable'
DB_USERNAME='ddd_app'
DB_PASSWORD='changeme_app'
